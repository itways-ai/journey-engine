<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Two artifacts, released together at one version:

          journey-model       the journey document and its statuses — what
                              journey-service stores and serves, and what the
                              engine executes — plus the step catalogue types
                              the builder reads and the step graph both use.
                              Plain data, no Spring.
          journey-engine-sdk  the engine that runs it.

        journey-service needs the first and must not pull in the second (GraalVM,
        FreeMarker, the AI SDK), which is why they are separate jars.

        The platform parent sets Java 21, manages the versions (Spring Boot 3.2.2,
        the in-house libraries through platform-bom) and runs JaCoCo, surefire and
        the sources jar in both modules. These are libraries: no
        spring-boot-maven-plugin.
    -->
    <parent>
        <groupId>com.itways</groupId>
        <artifactId>platform-parent</artifactId>
        <version>2.2.0</version>
        <relativePath/>
    </parent>

    <!-- Explicit: platform-bom names the modules with this groupId and version. -->
    <groupId>com.itways.assistant</groupId>
    <artifactId>journey-engine-parent</artifactId>
    <version>1.0.20</version>
    <packaging>pom</packaging>

    <name>journey-engine-parent</name>
    <description>The journey model and the journey engine SDK, released together at one version</description>

    <modules>
        <module>journey-model</module>
        <module>journey-engine-sdk</module>
    </modules>

    <build>
        <plugins>
            <!-- The shared formatter, configured in platform-parent: `mvn spotless:apply` / `mvn spotless:check`. -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
